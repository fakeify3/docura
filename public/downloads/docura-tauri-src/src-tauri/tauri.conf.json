{
  "$schema": "../schema.json",
  "productName": "DOCURA",
  "version": "1.0.0",
  "identifier": "com.docura.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "DOCURA — DOCX to PDF",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/portable-soffice/**/*"
    ],
    "category": "Productivity",
    "shortDescription": "Premium DOCX to PDF converter",
    "longDescription": "DOCURA converts Word documents to PDF using a real LibreOffice conversion engine. Premium, privacy-conscious, fully offline."
  }
}
